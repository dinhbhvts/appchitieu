# Copy this file to ".env" and adjust as needed.
# Development uses a local SQLite file and needs no changes.

# --- Database ---
# SQLite (default, no server needed):
DATABASE_URL=sqlite:///./vibeapp.db
# PostgreSQL (production) example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vibeapp

# --- CORS ---
# Comma-separated list of allowed origins, or * for all (dev only).
CORS_ORIGINS=*
